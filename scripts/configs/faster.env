# Faster-FermiNet switches of the measured configuration (round 8 final, formal gate PASS).
# Both optimizations are ON by default in the code; this file only makes the measured
# values explicit. Usage: source scripts/configs/faster.env
export FERMINET_PALLAS_TRSM=1           # bit-exact Pallas replacement of batched cuBLAS trsm (0 = cuBLAS path)
export FERMINET_PALLAS_TRSM_WARPS=1     # warps per Triton program (measured value)
export FERMINET_PALLAS_TRSM_COLS=64     # columns per program; 64 = one program per matrix (measured value)
export FERMINET_LAPLACIAN_UNROLL=2      # unroll of the Hessian-diagonal loop (1 = upstream loop form)
# Not set: timing uses XLA's default flags. Bit-wise checks add
#   XLA_FLAGS=--xla_gpu_deterministic_ops=true  (see docs/judge.md)
